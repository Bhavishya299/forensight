# ============================================================
# FORENSIGHT Backend — Environment
# Copy this file to .env and fill the secrets. On first start
# missing secrets (SECRET_KEY / FERNET_KEY) are auto-generated
# and written into .env so they are never committed or hardcoded.
# ============================================================

# --- Server -----------------------------------------------------
DEBUG=false

# --- Secrets (JWT signing + at-rest field encryption) -----------
# Leave empty to auto-generate into local .env on first start.
SECRET_KEY=
FERNET_KEY=

# --- Database ---------------------------------------------------
# Use a *file* database (forensight.db). Do not use :memory: —
# seeded data would be lost on restart.
DATABASE_URL=sqlite:///forensight.db

# --- Tokens -----------------------------------------------------
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Analysis ---------------------------------------------------
# Sliding-window critical-event scan (configurable, NOT hardcoded)
ANALYSIS_SLIDING_WINDOW_MINUTES=20
ANALYSIS_SLIDING_STEP_MINUTES=10
ANOMALY_ZSCORE_THRESHOLD=2.0
ANOMALY_BASELINE_AMOUNT=100000

# --- CORS (comma separated) -------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Evidence uploads -------------------------------------------
MAX_UPLOAD_MB=25